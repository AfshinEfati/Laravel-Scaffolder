{
  "name": "efati/laravel-scaffolder",
  "description": "Laravel package for generating complete feature stacks with repositories, services, DTOs, actions, policies, API resources, tests, and OpenAPI documentation.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "laravel-package",
    "scaffolding",
    "code-generator",
    "developer-tools",
    "repository-pattern",
    "dto",
    "policy",
    "openapi",
    "phpunit"
  ],
  "homepage": "https://github.com/AfshinEfati/Laravel-Scaffolder",
  "support": {
    "issues": "https://github.com/AfshinEfati/Laravel-Scaffolder/issues",
    "source": "https://github.com/AfshinEfati/Laravel-Scaffolder"
  },
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
    "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Efati\\ModuleGenerator\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Efati\\ModuleGenerator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Efati\\ModuleGenerator\\ModuleGeneratorServiceProvider"
      ]
    }
  }
}
