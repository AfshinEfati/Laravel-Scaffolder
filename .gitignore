# Ignore PHPStorm / JetBrains project files
.idea/
*.iml

# Ignore VSCode project files
.vscode/
.history/
.vscode/*
.agents
.agents/*

# Ignore MacOS system files
.DS_Store

# Ignore system generated files
Thumbs.db
ehthumbs.db

# Ignore node modules (if frontend exists)
node_modules/

# Composer dependencies and package lock
vendor/
composer.lock

# Ignore environment files
.env
.env.*

*_Zone.Identifier*
*.Zone.Identifier

# Python / local tooling
.venv/
.venv/*

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# Local test/debug artifacts
TEST_OUTPUT.php

# Generated documentation artifacts
docs-site/.data/
